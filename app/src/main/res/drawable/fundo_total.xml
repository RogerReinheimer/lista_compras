<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- sombra sutil (simulada com item atrás) -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#11000000"/> <!-- sombra muito leve -->
            <corners android:radius="8dp"/>
        </shape>
    </item>

    <!-- fundo principal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EAF6EA"/> <!-- verde muito claro -->
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="#DFF0DF"/>
        </shape>
    </item>
</layer-list>
