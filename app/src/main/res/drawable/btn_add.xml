<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#C7E0FF"/> <!-- tom mais escuro ao pressionar -->
            <corners android:radius="10dp"/>
        </shape>
    </item>

    <!-- normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E0E7FF"/> <!-- fundo claro azul -->
            <corners android:radius="10dp"/>
            <stroke android:width="1dp" android:color="#D1D9FF"/>
        </shape>
    </item>
</selector>
