<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- fundo branco -->
    <solid android:color="#FFFFFF" />

    <!-- borda sutil -->
    <stroke
        android:width="1dp"
        android:color="#E6EEF6" />

    <!-- cantos arredondados só no topo (ideal para bottomsheet) -->
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="6dp"
        android:bottomRightRadius="6dp" />

    <!-- espaçamento interno (opcional, o layout também pode controlar) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

</shape>
