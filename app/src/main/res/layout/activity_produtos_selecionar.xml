<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3E8DF">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/txtTituloSelecionar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecionar Produtos"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#452829"
        android:layout_marginTop="32dp"
        android:layout_centerHorizontal="true" />

    <!-- BUSCA -->
    <EditText
        android:id="@+id/edtBuscarProdutoSelecao"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/txtTituloSelecionar"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp"
        android:hint="Buscar produto..."
        android:paddingHorizontal="16dp"
        android:background="@drawable/card_secundario"
        android:textColor="#452829"
        android:textColorHint="#452829" />

    <!-- LISTA DE PRODUTOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSelecionarProdutos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/edtBuscarProdutoSelecao"
        android:layout_above="@id/layoutBotoes"
        android:padding="16dp" />

    <!-- BOTÕES -->
    <LinearLayout
        android:id="@+id/layoutBotoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/footer"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp">

        <!-- BOTÃO CANCELAR -->
        <TextView
            android:id="@+id/btnCancelar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/card_secundario"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="#29353C"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- BOTÃO ADICIONAR -->
        <TextView
            android:id="@+id/btnAdicionar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/card_principal"
            android:gravity="center"
            android:text="Adicionar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- RODAPÉ -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/card_secundario"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            app:tint="#7A5A54"/>

        <ImageView
            android:id="@+id/iconListas"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_lista"
            app:tint="#7A5A54"/>

        <ImageView
            android:id="@+id/iconCategorias"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_pasta"
            app:tint="#7A5A54" />

        <ImageView
            android:id="@+id/iconProdutos"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_caixa"
            app:tint="#000000"/>

    </LinearLayout>

</RelativeLayout>
