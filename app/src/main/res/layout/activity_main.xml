<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DFEBF6"
    tools:context=".MainActivity">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/img_logo"
            app:tint="#64748B"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minha Lista de Compras"
            android:textColor="#29353C"
            android:textSize="22sp"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CONTEÚDO -->
    <LinearLayout
        android:id="@+id/containerOpcoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <!-- BOTÃO PRINCIPAL -->
        <LinearLayout
            android:id="@+id/btnVerListas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_principal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="18dp"
                android:src="@drawable/ic_lista"
                app:tint="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver Listas"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Categoria -->
        <LinearLayout
            android:id="@+id/btnCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_secundario"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_pasta"
                app:tint="#475569"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categorias"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#29353C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explore categorias de produtos"
                    android:textSize="14sp"
                    android:textColor="#64748B" />
            </LinearLayout>
        </LinearLayout>

        <!-- Salvos -->
        <LinearLayout
            android:id="@+id/btnProdutosSalvos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_secundario"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_caixa"
                app:tint="#475569"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Produtos Salvos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#29353C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seus favoritos em um lugar"
                    android:textSize="14sp"
                    android:textColor="#64748B" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- RODAPÉ -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            app:tint="#29353C"/>

        <ImageView
            android:id="@+id/iconListas"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_lista"
            app:tint="#94A3B8"/>

        <ImageView
            android:id="@+id/iconCategorias"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_pasta"
            app:tint="#94A3B8"/>

        <ImageView
            android:id="@+id/iconProdutos"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_caixa"
            app:tint="#94A3B8"/>
    </LinearLayout>

</RelativeLayout>
