<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/fundo_card"
    android:elevation="4dp">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Compras do Mês"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:text="Itens"
                android:textColor="#777"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/txtItens"
                android:text="24 itens"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:text="Total"
                android:textColor="#777"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/txtTotal"
                android:text="R$ 856,50"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#27AE60" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:text="Criada em"
                android:textColor="#777"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/txtData"
                android:text="15 de Jan"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/btnEditar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_editar"
            android:tint="#777"
            android:layout_marginEnd="8dp"/>

        <ImageView
            android:id="@+id/btnExcluir"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_lixeira"
            android:tint="#777"/>
    </LinearLayout>
</LinearLayout>
