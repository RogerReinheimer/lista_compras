<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DFEBF6">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/txtTituloNovoProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Novo Produto"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#29353C"
        android:layout_marginTop="32dp"
        android:layout_centerHorizontal="true" />

    <!-- FORMULÁRIO -->
    <LinearLayout
        android:id="@+id/containerFormulario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/txtTituloNovoProduto"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp">

        <!-- DESCRIÇÃO -->
        <EditText
            android:id="@+id/edtNome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Digite o nome do produto"
            android:background="@drawable/card_secundario"
            android:padding="16dp"
            android:textColor="#29353C"
            android:textColorHint="#64748B"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtDescricaoProduto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="Digite a descrição do produto"
            android:background="@drawable/card_secundario"
            android:padding="16dp"
            android:textColor="#29353C"
            android:textColorHint="#64748B"
            android:textSize="16sp" />

        <!-- QUANTIDADE -->
        <EditText
            android:id="@+id/edtQuantidadeProduto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="Quantidade"
            android:inputType="number"
            android:background="@drawable/card_secundario"
            android:padding="16dp"
            android:textColor="#29353C"
            android:textColorHint="#64748B"
            android:textSize="16sp" />

        <!-- UNIDADE -->
        <Spinner
            android:id="@+id/spinnerUnidade"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_secundario"
            android:padding="16dp"
            android:spinnerMode="dropdown" />

        <!-- PREÇO -->
        <EditText
            android:id="@+id/edtPrecoProduto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="R$ 0,00"
            android:inputType="numberDecimal"
            android:background="@drawable/card_secundario"
            android:padding="16dp"
            android:textColor="#29353C"
            android:textColorHint="#64748B"
            android:textSize="16sp" />

        <!-- CATEGORIA -->
        <Spinner
            android:id="@+id/spinnerCategoriaProduto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_secundario"
            android:padding="16dp"
            android:spinnerMode="dropdown" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerBotoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_above="@id/footer"
        android:padding="24dp">

        <!-- SALVAR -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSalvar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Salvar"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/card_principal" />

        <Space
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <!-- CANCELAR -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textStyle="bold"
            android:textColor="#29353C"
            android:background="@drawable/card_secundario" />
    </LinearLayout>

    <!-- RODAPÉ -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            app:tint="#94A3B8"/>

        <ImageView
            android:id="@+id/iconListas"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_lista"
            app:tint="#94A3B8"/>

        <ImageView
            android:id="@+id/iconCategorias"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_pasta"
            app:tint="#29353C"/>

        <ImageView
            android:id="@+id/iconProdutos"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_caixa"
            app:tint="#94A3B8"/>
    </LinearLayout>

</RelativeLayout>
