<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".NovaLista">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nova Lista de Compras"
        android:textColor="#29353C"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/inputNomeLista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtTitulo"
        android:layout_margin="12dp"
        android:hint="Nome da lista"
        android:background="@drawable/fundo_texto"
        android:padding="8dp"
        android:textColor="#111"
        android:textSize="16sp" />

    <ScrollView
        android:id="@+id/scrollProdutos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/inputNomeLista"
        android:layout_margin="8dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerProdutos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/card_produto_lista" />
            <include layout="@layout/card_produto_lista" />
            <include layout="@layout/card_produto_lista" />

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAdicionarProduto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/totalContainer"
        android:text="+ Adicionar Produto"
        android:textAllCaps="false"
        android:textColor="#2563EB"
        android:background="@drawable/btn_add"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:paddingVertical="12dp" />

    <LinearLayout
        android:id="@+id/totalContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/footerButtons"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:background="@drawable/fundo_total"
        android:padding="12dp"
        android:layout_margin="12dp">

        <TextView
            android:id="@+id/txtTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total: R$ 27,20"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#178C4A" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footerButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/footer"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#475569"
            android:textStyle="bold"
            android:background="@drawable/btn_cancelar"
            android:layout_marginEnd="8dp"
            android:paddingVertical="14dp"
            android:paddingHorizontal="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSalvar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Salvar Lista"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_salvar"
            android:paddingVertical="14dp"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            app:tint="#94A3B8" />

        <ImageView
            android:id="@+id/iconListas"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_lista"
            app:tint="#94A3B8" />

        <ImageView
            android:id="@+id/iconCategorias"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_pasta"
            app:tint="#94A3B8" />

        <ImageView
            android:id="@+id/iconProdutos"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_caixa"
            app:tint="#94A3B8" />
    </LinearLayout>

</RelativeLayout>
