<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_secundario"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <!-- CABEÇALHO DO PRODUTO -->
    <LinearLayout
        android:id="@+id/headerProduto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtNomeProdutoCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nome do Produto"
            android:textColor="#29353C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- CHECKBOX PARA SELEÇÃO -->
        <CheckBox
            android:id="@+id/checkSelecionarProduto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#29353C"
            android:layout_marginEnd="12dp"/>

        <!-- EXPANDIR DETALHES -->
        <ImageView
            android:id="@+id/btnExpandirProduto"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/flecha_baixo"
            app:tint="#64748B"/>
    </LinearLayout>

    <!-- ÁREA EXPANSÍVEL -->
    <LinearLayout
        android:id="@+id/containerDetalhesProduto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtDescricaoProdutoCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição: Produto de teste"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtPrecoProdutoCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preço: R$ 10,00"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/txtQuantidadeProdutoCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantidade: 1,0"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txtUnidadeProdutoCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unidade: UN"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
